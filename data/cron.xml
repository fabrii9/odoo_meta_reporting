<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="cron_sync_meta_ads_daily" model="ir.cron">
    <field name="name">Meta Ads - Sincronización Diaria</field>
    <field name="model_id" ref="model_meta_ads_sync_job"/>
    <field name="state">code</field>
    <field name="code">model.sync_meta_ads_data()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field name="active" eval="True"/>
    <field name="doall" eval="False"/>
    <!-- 03:00 AM -->
    <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
  </record>


  <record id="cron_refresh_meta_tokens_weekly" model="ir.cron">
    <field name="name">Meta Ads - Renovación de Tokens</field>
    <field name="model_id" ref="model_meta_ads_account"/>
    <field name="state">code</field>
    <field name="code">model.cron_refresh_expiring_tokens()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">weeks</field>
    <field name="numbercall">-1</field>
    <field name="active" eval="True"/>
    <field name="doall" eval="False"/>
    <!-- Lunes 02:00 AM -->
    <field name="nextcall" eval="(DateTime.now().replace(hour=2, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
  </record>

</odoo>

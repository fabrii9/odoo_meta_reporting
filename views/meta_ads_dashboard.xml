<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="meta_ads_dashboard_template" name="Meta Ads Dashboard">
    <t t-call="web.layout">
      <div class="o_meta_ads_dashboard">
        <!-- Header / Filtros -->
        <div class="dashboard-header">
          <div class="brand">
            <img src="/odoo_meta_reporting/static/description/icon.png" alt="Meta" class="brand-logo"/>
            <h1>Dashboard Meta Ads</h1>
          </div>
          <div class="filters">
            <select id="filter-account" class="filter-control" title="Cuenta publicitaria de Meta Ads">
              <option value="">Seleccionar cuenta...</option>
              <t t-foreach="accounts" t-as="account">
                <option t-att-value="account.id" t-esc="account.name"/>
              </t>
            </select>
            <input id="filter-campaign" type="text" class="filter-control" placeholder="Campaña (opcional)" title="Filtrar por nombre exacto de campaña"/>
            <input id="filter-date-from" type="date" class="filter-control" t-att-value="default_date_from" title="Fecha inicial"/>
            <input id="filter-date-to" type="date" class="filter-control" t-att-value="default_date_to" title="Fecha final"/>
            <button id="btn-refresh" class="btn-refresh" title="Consultar datos en BigQuery">Actualizar</button>
          </div>
        </div>

        <!-- Loading -->
        <div id="dashboard-loading" class="dashboard-loading hidden">Cargando datos...</div>
        <div id="dashboard-error" class="dashboard-error hidden"></div>

        <!-- KPIs -->
        <div class="kpi-grid" id="kpi-grid">
          <div class="kpi-card">
            <div class="kpi-label">Gasto total <span class="help-icon" data-tooltip="Gasto total en publicidad durante el período seleccionado.">?</span></div>
            <div class="kpi-value" id="kpi-spend">-</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Impresiones <span class="help-icon" data-tooltip="Número de veces que se mostraron tus anuncios.">?</span></div>
            <div class="kpi-value" id="kpi-impressions">-</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Clics en enlace <span class="help-icon" data-tooltip="Clics que hicieron en el enlace de tu anuncio.">?</span></div>
            <div class="kpi-value" id="kpi-clicks">-</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">CTR <span class="help-icon" data-tooltip="Click-Through Rate: porcentaje de impresiones que terminaron en clic.">?</span></div>
            <div class="kpi-value" id="kpi-ctr">-</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">CPC <span class="help-icon" data-tooltip="Costo por clic: cuánto pagás en promedio por cada clic.">?</span></div>
            <div class="kpi-value" id="kpi-cpc">-</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Alcance <span class="help-icon" data-tooltip="Número de personas únicas que vieron tus anuncios.">?</span></div>
            <div class="kpi-value" id="kpi-reach">-</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Frecuencia <span class="help-icon" data-tooltip="Promedio de veces que cada persona vio tus anuncios.">?</span></div>
            <div class="kpi-value" id="kpi-frequency">-</div>
          </div>
        </div>

        <!-- KPIs de conversión -->
        <div class="kpi-grid kpi-grid-secondary">
          <div class="kpi-card">
            <div class="kpi-label">Compras <span class="help-icon" data-tooltip="Número de compras atribuidas a tus anuncios (desde acciones de Meta).">?</span></div>
            <div class="kpi-value" id="kpi-purchases">-</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Valor de compra <span class="help-icon" data-tooltip="Valor monetario total de las compras atribuidas.">?</span></div>
            <div class="kpi-value" id="kpi-purchase-value">-</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">ROAS <span class="help-icon" data-tooltip="Return on Ad Spend: retorno sobre inversión publicitaria (valor de compra / gasto).">?</span></div>
            <div class="kpi-value" id="kpi-roas">-</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Costo por compra <span class="help-icon" data-tooltip="Gasto promedio para conseguir una compra.">?</span></div>
            <div class="kpi-value" id="kpi-cost-per-purchase">-</div>
          </div>
        </div>

        <!-- Gráficos principales -->
        <div class="chart-grid">
          <div class="card chart-card">
            <h3>Rendimiento diario <span class="help-icon" data-tooltip="Evolución diaria de las métricas principales.">?</span></h3>
            <canvas id="chart-daily"></canvas>
          </div>
          <div class="card chart-card">
            <h3>Ubicación <span class="help-icon" data-tooltip="Distribución por plataforma (Facebook, Instagram, etc.).">?</span></h3>
            <canvas id="chart-placement"></canvas>
          </div>
        </div>

        <!-- Embudo -->
        <div class="card funnel-card">
          <h3>Embudo <span class="help-icon" data-tooltip="Embudo de conversión: de impresiones a clics y compras.">?</span></h3>
          <div class="funnel" id="funnel">
            <div class="funnel-step">
              <span class="funnel-label">Impresiones</span>
              <span class="funnel-value" id="funnel-impressions">-</span>
            </div>
            <div class="funnel-arrow">↓</div>
            <div class="funnel-step">
              <span class="funnel-label">Clics en enlace</span>
              <span class="funnel-value" id="funnel-clicks">-</span>
              <span class="funnel-rate" id="funnel-ctr">-</span>
            </div>
            <div class="funnel-arrow">↓</div>
            <div class="funnel-step">
              <span class="funnel-label">Compras</span>
              <span class="funnel-value" id="funnel-purchases">-</span>
              <span class="funnel-rate" id="funnel-purchase-rate">-</span>
            </div>
          </div>
        </div>

        <!-- Tabs de niveles -->
        <div class="card">
          <div class="level-tabs">
            <button class="tab-btn active" data-tab="campaigns">
              Campañas <span class="help-icon" data-tooltip="Resultados agrupados por campaña.">?</span>
            </button>
            <button class="tab-btn" data-tab="adsets">
              Adsets <span class="help-icon" data-tooltip="Resultados agrupados por conjunto de anuncios.">?</span>
            </button>
            <button class="tab-btn" data-tab="ads">
              Anuncios / Creatividades <span class="help-icon" data-tooltip="Resultados agrupados por anuncio o creatividad.">?</span>
            </button>
          </div>

          <div class="tab-content" id="tab-campaigns">
            <table class="data-table" id="table-campaigns">
              <thead>
                <tr>
                  <th>Nombre de campaña</th>
                  <th class="numeric">Gasto</th>
                  <th class="numeric">Impresiones</th>
                  <th class="numeric">Clics</th>
                  <th class="numeric">CTR</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>

          <div class="tab-content hidden" id="tab-adsets">
            <table class="data-table" id="table-adsets">
              <thead>
                <tr>
                  <th>Campaña</th>
                  <th>Nombre del adset</th>
                  <th class="numeric">Gasto</th>
                  <th class="numeric">Impresiones</th>
                  <th class="numeric">Clics</th>
                  <th class="numeric">CTR</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>

          <div class="tab-content hidden" id="tab-ads">
            <table class="data-table" id="table-ads">
              <thead>
                <tr>
                  <th>Campaña</th>
                  <th>Nombre del anuncio</th>
                  <th class="numeric">Gasto</th>
                  <th class="numeric">Impresiones</th>
                  <th class="numeric">Clics</th>
                  <th class="numeric">CTR</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>

      <link rel="stylesheet" href="/odoo_meta_reporting/static/src/css/dashboard.css"/>
      <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"/>
      <script type="text/javascript" src="/odoo_meta_reporting/static/src/js/dashboard_v2.js"/>
    </t>
  </template>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ========== SYNC LOG VIEWS ========== -->

  <record id="view_meta_ads_sync_log_tree" model="ir.ui.view">
    <field name="name">meta.ads.sync.log.tree</field>
    <field name="model">meta.ads.sync.log</field>
    <field name="arch" type="xml">
      <tree string="Logs de Sincronización" decoration-muted="status=='partial'" decoration-danger="status=='error'" decoration-success="status=='success'">
        <field name="sync_date"/>
        <field name="account_id"/>
        <field name="sync_type"/>
        <field name="level"/>
        <field name="date_from"/>
        <field name="date_to"/>
        <field name="records_processed"/>
        <field name="status"/>
        <field name="execution_time"/>
      </tree>
    </field>
  </record>

  <record id="view_meta_ads_sync_log_form" model="ir.ui.view">
    <field name="name">meta.ads.sync.log.form</field>
    <field name="model">meta.ads.sync.log</field>
    <field name="arch" type="xml">
      <form string="Log de Sincronización" edit="false" create="false" delete="false">
        <sheet>
          <group>
            <group>
              <field name="account_id"/>
              <field name="sync_date"/>
              <field name="sync_type"/>
              <field name="level"/>
            </group>
            <group>
              <field name="date_from"/>
              <field name="date_to"/>
              <field name="records_processed"/>
              <field name="execution_time"/>
              <field name="status"/>
            </group>
          </group>
          <field name="error_message" attrs="{'invisible': [('status', '!=', 'error')]}"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_meta_ads_sync_log" model="ir.actions.act_window">
    <field name="name">Logs de Sincronización</field>
    <field name="res_model">meta.ads.sync.log</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_group_by_account': 1}</field>
  </record>

  <record id="view_meta_ads_sync_log_search" model="ir.ui.view">
    <field name="name">meta.ads.sync.log.search</field>
    <field name="model">meta.ads.sync.log</field>
    <field name="arch" type="xml">
      <search string="Buscar Logs">
        <field name="account_id"/>
        <field name="status"/>
        <field name="sync_type"/>
        <group expand="0" string="Agrupar por">
          <filter name="group_by_account" string="Cuenta" context="{'group_by': 'account_id'}"/>
          <filter name="group_by_status" string="Estado" context="{'group_by': 'status'}"/>
          <filter name="group_by_date" string="Fecha Sync" context="{'group_by': 'sync_date:day'}"/>
        </group>
      </search>
    </field>
  </record>

</odoo>
